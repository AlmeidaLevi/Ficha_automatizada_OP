<p style="color: green"><%= notice %></p>

<% content_for :title, "Characters" %>

<h1>Characters</h1>

<div id="characters">
  <% @characters.each do |character| %>
    <%= render character %>
    <%= link_to "Show/edit this character", edit_character_path(character) %>
    <%= button_to "Delete this character", character_path(character), method: :delete, data: { turbo_confirm: "Are you sure?" } %>
    <p>
    </p>
  <% end %>
</div>

<%= button_to "New character", characters_path, method: :post %>
<%= button_to "log out", session_path, method: :delete %>
