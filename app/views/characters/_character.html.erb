<div id="<%= dom_id character %>">
  <div>
    <strong><%= character.name %></strong>
  </div>

  <div>
    <strong><%= character.origin.capitalize %></strong>
  </div>


  <div>
    <strong><%= character.character_class.capitalize %></strong>
  </div>

  <div>
    <strong><%= character.archetype.capitalize %></strong>
  </div>

  <div>
    <strong>Nex: <%= character.nex %></strong>
  </div>

</div>
