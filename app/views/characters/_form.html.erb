<%= form_with(model: character) do |form| %>
  <% if character.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(character.errors.count, "error") %> prohibited this character from being saved:</h2>

      <ul>
        <% character.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label "Nome do personagem:", style: "display: block" %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label "Origem:", style: "display: block" %>
    <%= form.select :origin, [
      ["Acadêmico", "academico"],
      ["Agente de Saúde", "agente_de_saude"],
      ["Amnésico", "amnesico"],
      ["Artista", "artista"],
      ["Atleta", "atleta"],
      ["Chef", "chef"],
      ["Criminoso", "criminoso"],
      ["Cultista Arrependido", "cultista_arrependido"],
      ["Desgarrado", "desgarrado"],
      ["Engenheiro", "engenheiro"],
      ["Executivo", "executivo"],
      ["Investigador", "investigador"],
      ["Lutador", "lutador"],
      ["Magnata", "magnata"],
      ["Mercenário", "mercenario"],
      ["Militar", "militar"],
      ["Operário", "operario"],
      ["Policial", "policial"],
      ["Religioso", "religioso"],
      ["Servidor Público", "servidor_publico"],
      ["Teórico da Conspiração", "teorico_da_conspiracao"],
      ["T.I.", "ti"],
      ["Trabalhador Rural", "trabalhador_rural"],
      ["Trambiqueiro", "trambiqueiro"],
      ["Universitário", "universitario"],
      ["Vítima", "vitima"]
    ] %>
  </div>

  <div data-controller="archetype-selector">
    <div>
      <%= form.label "Classe:", style: "display: block" %>
      <%= form.select :character_class, [
        ["Combatente", "combatente"],
        ["Especialista", "especialista"],
        ["Ocultista", "ocultista"]
        ],
        {},
        data: {
          archetype_selector_target: "characterClass",
          action: "
                  change->archetype-selector#updateArchetype
                  change->archetype-selector#notifyClassChange
                  "
        }
      %>
    </div>

    <div>
      <%= form.label "Trilha:", style: "display: block" %>
      <%= form.select :archetype,
        [],
        {},
        data: {
          archetype_selector_target: "archetype"
        }
      %>
    </div>
  </div>

<div data-controller="number-fields"
     data-number-fields-current-Pv-value="<%= @character.current_pv %>"
     data-number-fields-current-Pe-value="<%= @character.current_pe %>"
     data-number-fields-current-Sanity-value="<%= @character.current_sanity %>"
>
  <div>
    <%= form.label "Pontos de Vida: ", style: "display: block" %>
    <%= form.hidden_field :current_pv, min: 0,
      data: {
        number_fields_target: "PV",
        action: "archetype-selector:changed@document->number-fields#updateMaxPV"
      }
    %>
    <button type="button" data-action="click->number-fields#decreaseFivePV">&lt;&lt;</button>
    <button type="button" data-action="click->number-fields#decrementPV">&lt;</button>
      <span data-number-fields-target="DisplayPV">

      </span>
    <button type="button" data-action="click->number-fields#incrementPV">&gt;</button>
    <button type="button" data-action="click->number-fields#increaseFivePV">&gt;&gt;</button>
  </div>

  <div>
    <%= form.label "Pontos de Esforço: ", style: "display: block" %>
    <%= form.hidden_field :current_pe, min: 0,
      data: {
        number_fields_target: "PE",
        action: "archetype-selector:changed@document->number-fields#updateMaxPE"
      }
    %>
    <button type="button" data-action="click->number-fields#decreaseFivePE">&lt;&lt;</button>
    <button type="button" data-action="click->number-fields#decrementPE">&lt;</button>
      <span data-number-fields-target="DisplayPE">

      </span>
    <button type="button" data-action="click->number-fields#incrementPE">&gt;</button>
    <button type="button" data-action="click->number-fields#increaseFivePE">&gt;&gt;</button>
  </div>

  <div>
    <%= form.label "Sanidade: ", style: "display: block" %>
    <%= form.hidden_field :current_sanity, min: 0,
      data: {
        number_fields_target: "Sanity",
        action: "archetype-selector:changed@document->number-fields#updateMaxSanity"
      }
    %>
    <button type="button" data-action="click->number-fields#decreaseFiveSanity">&lt;&lt;</button>
    <button type="button" data-action="click->number-fields#decrementSanity">&lt;</button>
    <span data-number-fields-target="DisplaySanity">

    </span>
    <button type="button" data-action="click->number-fields#incrementSanity">&gt;</button>
    <button type="button" data-action="click->number-fields#increaseFiveSanity">&gt;&gt;</button>
  </div>

  <div>
    <%= form.label "NEX (Nivel de Exposição):", style: "display: block" %>
    <%= form.number_field :nex, min: 0, max: 99,
      data: {
        number_fields_target: "NEX",
        action: "
                change->number-fields#updateMaxPV
                change->number-fields#updateMaxPE
                change->number-fields#updateMaxSanity
                "
      }
    %>
  </div>

  <div>
    <%= form.label "Patente:", style: "display: block" %>
    <%= form.text_field :patent %>
  </div>

  <div>
    <%= form.label "Pontos de prestigio:", style: "display: block" %>
    <%= form.number_field :prestige_points %>
  </div>

  <div>
    <%= form.label "Elemento de afinidade:", style: "display: block" %>
    <%= form.text_field :element_affinity %>
  </div>

  <div>
    <%= form.label "FOR (Força):", style: "display: block" %>
    <%= form.number_field :for, min: 0, max: @character.max_attribute_points,
      data: {
        number_fields_target: "FOR",
      }
    %>
  </div>

  <div>
    <%= form.label "AGI (Agilidade):", style: "display: block" %>
    <%= form.number_field :agi, min: 0, max: @character.max_attribute_points,
      data: {
        number_fields_target: "AGI"
      }
    %>
  </div>

  <div>
    <%= form.label "INT (Inteligencia):", style: "display: block" %>
    <%= form.number_field :int, min: 0, max: @character.max_attribute_points,
      data: {
        number_fields_target: "INT"
      }
    %>
  </div>

  <div>
    <%= form.label "PRE (Presença):", style: "display: block" %>
    <%= form.number_field :pre, min: 0, max: @character.max_attribute_points,
      data: {
        number_fields_target: "PRE",
        action: "change->number-fields#updateMaxPE"
      }
    %>
  </div>

  <div>
    <%= form.label "VIG (Vigor):", style: "display: block" %>
    <%= form.number_field :vig, min: 0, max: @character.max_attribute_points,
      data: {
        number_fields_target: "VIG",
        action: "change->number-fields#updateMaxPV"
      }
    %>
  </div>

  <div>
    <%= form.submit "Salvar" %>
  </div>
</div>
<% end %>
