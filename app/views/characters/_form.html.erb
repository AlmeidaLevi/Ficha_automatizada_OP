<%= form_with(model: character) do |form| %>
  <% if character.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(character.errors.count, "error") %> prohibited this character from being saved:</h2>

      <ul>
        <% character.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label "Nome do personagem:", style: "display: block" %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label "Origem:", style: "display: block" %>
    <%= form.select :origin, [
      ["Acadêmico", "academico"],
      ["Agente de Saúde", "agente_de_saude"],
      ["Amnésico", "amnesico"],
      ["Artista", "artista"],
      ["Atleta", "atleta"],
      ["Chef", "chef"],
      ["Criminoso", "criminoso"],
      ["Cultista Arrependido", "cultista_arrependido"],
      ["Desgarrado", "desgarrado"],
      ["Engenheiro", "engenheiro"],
      ["Executivo", "executivo"],
      ["Investigador", "investigador"],
      ["Lutador", "lutador"],
      ["Magnata", "magnata"],
      ["Mercenário", "mercenario"],
      ["Militar", "militar"],
      ["Operário", "operario"],
      ["Policial", "policial"],
      ["Religioso", "religioso"],
      ["Servidor Público", "servidor_publico"],
      ["Teórico da Conspiração", "teorico_da_conspiracao"],
      ["T.I.", "ti"],
      ["Trabalhador Rural", "trabalhador_rural"],
      ["Trambiqueiro", "trambiqueiro"],
      ["Universitário", "universitario"],
      ["Vítima", "vitima"]
    ] %>
  </div>

  <div data-controller="archetype-selector">
    <div>
      <%= form.label "Classe:", style: "display: block" %>
      <%= form.select :character_class, [
        ["Combatente", "combatente"],
        ["Especialista", "especialista"],
        ["Ocultista", "ocultista"]
        ],
        {},
        data: {
          archetype_selector_target: "characterClass",
          action: "change->archetype-selector#updateArchetype"
        }
      %>
    </div>

    <div>
      <%= form.label "Trilha:", style: "display: block" %>
      <%= form.select :archetype,
        [],
        {},
        data: {
          archetype_selector_target: "archetype"
        }
      %>
    </div>
  </div>

  <div>
    <%= form.label "Pontos de Vida: ", style: "display: block" %>
    <%= form.number_field :current_pv %>
  </div>

  <div>
    <%= form.label "Pontos de Esforço: ", style: "display: block" %>
    <%= form.number_field :current_pe %>
  </div>

  <div>
    <%= form.label "Sanidade: ", style: "display: block" %>
    <%= form.number_field :current_sanity %>
  </div>

  <div>
    <%= form.label "NEX (Nivel de Exposição):", style: "display: block" %>
    <%= form.number_field :nex, min: 0, max: 99 %>
  </div>

  <div>
    <%= form.label "Patente:", style: "display: block" %>
    <%= form.text_field :patent %>
  </div>

  <div>
    <%= form.label "Pontos de prestigio:", style: "display: block" %>
    <%= form.number_field :prestige_points %>
  </div>

  <div>
    <%= form.label "Elemento de afinidade:", style: "display: block" %>
    <%= form.text_field :element_affinity %>
  </div>

  <div>
    <%= form.label "FOR (Força):", style: "display: block" %>
    <%= form.number_field :for, min: 0, max: @character.max_attribute_points %>
  </div>

  <div>
    <%= form.label "AGI (Agilidade):", style: "display: block" %>
    <%= form.number_field :agi, min: 0, max: @character.max_attribute_points %>
  </div>

  <div>
    <%= form.label "INT (Inteligencia):", style: "display: block" %>
    <%= form.number_field :int, min: 0, max: @character.max_attribute_points%>
  </div>

  <div>
    <%= form.label "PRE (Presença):", style: "display: block" %>
    <%= form.number_field :pre, min: 0, max: @character.max_attribute_points %>
  </div>

  <div>
    <%= form.label "VIG (Vigor):", style: "display: block" %>
    <%= form.number_field :vig, min: 0, max: @character.max_attribute_points %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
